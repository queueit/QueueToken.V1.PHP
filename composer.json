{
  "name": "queueit/queuetoken-v1-php",
  "version": "1.2.0",
  "description": "Queue-it PHP queue token library for managing enqueue tokens",
  "type": "library",
  "keywords": [
    "queue",
    "queueit",
    "queue-token",
    "enqueue-token",
    "traffic-management"
  ],
  "homepage": "https://queue-it.com",
  "license": "LGPL-3.0",
  "authors": [
    {
      "name": "Queue-it",
      "email": "support@queue-it.com"
    }
  ],
  "require": {
    "php": ">=8.2",
    "ext-openssl": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6.11"
  },
  "autoload": {
    "psr-4": {
      "QueueIT\\QueueToken\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "QueueIT\\QueueToken\\Tests\\": "tests/"
    }
  },
  "config": {
    "platform": {
      "php": "8.2.0"
    }
  },
  "extra": {
    "branch-alias": {
      "dev-main": "1.x-dev"
    }
  },
  "scripts": {
    "test": "phpunit --testdox"
  }
}
